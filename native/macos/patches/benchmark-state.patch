+bool LoadAsBlocking(Core::System& system, std::string filename)
+{
+  // Hold the CPU, audio and video locks until the load and any undo finish.
+  // The guard makes this a temporary CPU thread and avoids queued-job waits
+  // that could outlive the CPU thread during shutdown.
+  const Core::CPUThreadGuard guard(system);
+  if (!CheckIfStateLoadIsAllowed(system))
+    return false;
+  return LoadAsFromCore(system, std::move(filename));
+}
