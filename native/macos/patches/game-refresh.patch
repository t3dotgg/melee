+// State operations already run on the CPU thread. Use the loaded module's
+// handle so this optional hook also works for libraries with local symbols.
+void StaticRecompCore::PrepareNativeState(bool loading)
+{
+  if (!m_module_active || !m_library.IsOpen())
+    return;
+  using PrepareState = void (*)(CPUState*, u32);
+  const auto prepare = reinterpret_cast<PrepareState>(
+      m_library.GetSymbolAddress("MeleeNativePrepareState"));
+  if (prepare)
+    prepare(&m_guest, loading ? 1U : 0U);
+}
 
