 #include "Common/ChunkFile.h"
 #include "Common/CommonTypes.h"
 #include "Common/Config/Config.h"
+#include "Common/FixedFrameTiming.h"
 #include "Common/Logging/Log.h"
 
 #include "VideoCommon/OnScreenDisplay.h"
@@ -245,14 +248,47 @@ u32 VideoInterfaceManager::GetHalfLinesPerOddField() const
 
 u32 VideoInterfaceManager::GetTicksPerEvenField() const
 {
+  if (GetNativeRefreshRate() != 0)
+  {
+    const u32 odd_half_lines = GetHalfLinesPerOddField();
+    return GetNativeTickOffset(odd_half_lines + GetHalfLinesPerEvenField()) -
+           GetNativeTickOffset(odd_half_lines);
+  }
   return GetTicksPerHalfLine() * GetHalfLinesPerEvenField();
 }
 
 u32 VideoInterfaceManager::GetTicksPerOddField() const
 {
+  if (GetNativeRefreshRate() != 0)
+    return GetNativeTickOffset(GetHalfLinesPerOddField());
   return GetTicksPerHalfLine() * GetHalfLinesPerOddField();
 }
 
+u32 VideoInterfaceManager::GetNativeRefreshRate() const
+{
+  static const u32 requested_rate = []() -> u32 {
+    const char* value = std::getenv("MELEE_RENDER_FPS");
+    if (value && std::string_view(value) == "120")
+      return 120;
+    if (value && std::string_view(value) == "60")
+      return 60;
+    return 0;
+  }();
+
+  if (Core::WantsDeterminism() ||
+      GetHalfLinesPerOddField() + GetHalfLinesPerEvenField() == 0)
+    return 0;
+  return requested_rate;
+}
+
+u32 VideoInterfaceManager::GetNativeTickOffset(u32 half_line) const
+{
+  return Common::FixedFrameTickOffset(half_line,
+                                     GetHalfLinesPerOddField() + GetHalfLinesPerEvenField(),
+                                     GetNativeRefreshRate(),
+                                     m_system.GetSystemTimers().GetTicksPerSecond());
+}
+
 // Get the aspect ratio of VI's active area.
 float VideoInterfaceManager::GetAspectRatio() const
 {
@@ -536,6 +572,12 @@ u32 VideoInterfaceManager::GetNominalTicksPerHalfLine() const
 
 u32 VideoInterfaceManager::GetTicksPerHalfLine() const
 {
+  // The original 60 Hz input alarm and the NTSC VI run on different clocks.
+  // Keep native VI at exactly 60 or 120 Hz without changing game or audio time.
+  // Cumulative division carries the fraction between half-lines. Rounding each
+  // interval down would reintroduce drift and periodic dropped frames.
+  if (GetNativeRefreshRate() != 0)
+    return GetNativeTickOffset(m_half_line_count + 1) - GetNativeTickOffset(m_half_line_count);
   return GetNominalTicksPerHalfLine() / m_config_vi_oc_factor;
 }
 
