 u32 VideoInterfaceManager::GetTicksPerOddField() const
 {
+  if (GetNativeRefreshRate() != 0)
+    return GetNativeTickOffset(GetHalfLinesPerOddField());
   return GetTicksPerHalfLine() * GetHalfLinesPerOddField();
 }

+u32 VideoInterfaceManager::GetNativeRefreshRate() const
+{
+  static const u32 requested_rate = []() -> u32 {
+    const char* value = std::getenv("MELEE_RENDER_FPS");
+    if (value && std::string_view(value) == "120")
+      return 120;
+    if (value && std::string_view(value) == "60")
+      return 60;
+    return 0;
+  }();
+
+  if (Core::WantsDeterminism() ||
+      GetHalfLinesPerOddField() + GetHalfLinesPerEvenField() == 0)
+    return 0;
+  return requested_rate;
+}
+
+u32 VideoInterfaceManager::GetNativeTickOffset(u32 half_line) const
+{
+  return Common::FixedFrameTickOffset(half_line,
+                                     GetHalfLinesPerOddField() + GetHalfLinesPerEvenField(),
+                                     GetNativeRefreshRate(),
+                                     m_system.GetSystemTimers().GetTicksPerSecond());
+}
