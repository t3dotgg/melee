diff --git a/Source/Core/Common/FixedFrameTiming.h b/Source/Core/Common/FixedFrameTiming.h
new file mode 100644
index 0000000..c6f97c1
--- /dev/null
+++ b/Source/Core/Common/FixedFrameTiming.h
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstdint>
+
+namespace Common
+{
+// VI has two fields per full frame. Divide cumulative time so fractional cycles
+// carry between half-lines instead of shortening every scanline by rounding.
+constexpr std::uint32_t FixedFrameTickOffset(std::uint32_t half_line,
+                                           std::uint32_t half_lines_per_frame,
+                                           std::uint32_t fields_per_second,
+                                           std::uint32_t ticks_per_second)
+{
+  if (half_lines_per_frame == 0 || fields_per_second == 0)
+    return 0;
+  return static_cast<std::uint64_t>(half_line) * ticks_per_second * 2 /
+         (static_cast<std::uint64_t>(half_lines_per_frame) * fields_per_second);
+}
+}  // namespace Common
