+#ifdef __APPLE__
+// The generated C module finds this entry point with dlsym. Keep it exported
+// when the runtime uses hidden symbols and dead stripping.
+extern "C" __attribute__((visibility("default"), used)) void MeleeNativeWaitNanoseconds(u64 delay);
+
+extern "C" void MeleeNativeWaitNanoseconds(u64 delay)
+{
+  // Bound the conversion to a signed duration. The caller rechecks its deadline
+  // after the wait, so a long delay can be handled in several calls.
+  const auto duration = std::chrono::nanoseconds{static_cast<s64>(std::min<u64>(delay, 1000000000))};
+  Common::SleepUntilMacFrame(Clock::now() + duration);
+}
+#endif
