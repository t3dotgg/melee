 // Get the aspect ratio of VI's active area.
 float VideoInterfaceManager::GetAspectRatio() const
 {
@@ -536,6 +572,12 @@ u32 VideoInterfaceManager::GetNominalTicksPerHalfLine() const

 u32 VideoInterfaceManager::GetTicksPerHalfLine() const
 {
+  // The original 60 Hz input alarm and the NTSC VI run on different clocks.
+  // Keep native VI at exactly 60 or 120 Hz without changing game or audio time.
+  // Cumulative division carries the fraction between half-lines. Rounding each
+  // interval down would reintroduce drift and periodic dropped frames.
+  if (GetNativeRefreshRate() != 0)
+    return GetNativeTickOffset(m_half_line_count + 1) - GetNativeTickOffset(m_half_line_count);
   return GetNominalTicksPerHalfLine() / m_config_vi_oc_factor;
 }

