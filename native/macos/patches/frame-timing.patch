diff --git a/Source/Core/Common/FixedFrameTiming.h b/Source/Core/Common/FixedFrameTiming.h
new file mode 100644
index 0000000..2141bc2
--- /dev/null
+++ b/Source/Core/Common/FixedFrameTiming.h
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstdint>
+
+namespace Common
+{
+// VI has two fields per full frame. Divide cumulative time so fractional cycles
+// carry between half-lines instead of shortening every scanline by rounding.
+constexpr std::uint32_t FixedFrameTickOffset(std::uint32_t half_line,
+                                             std::uint32_t half_lines_per_frame,
+                                             std::uint32_t fields_per_second,
+                                             std::uint32_t ticks_per_second)
+{
+  if (half_lines_per_frame == 0 || fields_per_second == 0)
+    return 0;
+  return static_cast<std::uint64_t>(half_line) * ticks_per_second * 2 /
+         (static_cast<std::uint64_t>(half_lines_per_frame) * fields_per_second);
+}
+} // namespace Common
diff --git a/Source/Core/Common/MacFrameTimer.h b/Source/Core/Common/MacFrameTimer.h
new file mode 100644
index 0000000..c00386f
--- /dev/null
+++ b/Source/Core/Common/MacFrameTimer.h
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <sys/event.h>
+#include <unistd.h>
+
+namespace Common
+{
+// Only CPU and GPU frame threads request this policy. Other PrecisionTimer
+// users keep their existing scheduling policy.
+inline void ConfigureMacFrameThread()
+{
+  pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+  thread_latency_qos_policy_data_t policy{LATENCY_QOS_TIER_0};
+  const auto thread = mach_thread_self();
+  thread_policy_set(thread, THREAD_LATENCY_QOS_POLICY, reinterpret_cast<thread_policy_t>(&policy),
+                    THREAD_LATENCY_QOS_POLICY_COUNT);
+  mach_port_deallocate(mach_task_self(), thread);
+}
+
+// A critical kqueue timer avoids the coalescing used by mach_wait_until. Sleep
+// against an absolute deadline, then use a short CPU wait. A scheduler yield
+// in the final interval can give up the CPU past the frame deadline.
+inline void SleepUntilMacFrame(std::chrono::steady_clock::time_point target)
+{
+  using Clock = std::chrono::steady_clock;
+  constexpr auto spin_time = std::chrono::microseconds{200};
+  static const mach_timebase_info_data_t timebase = []
+  {
+    mach_timebase_info_data_t result{};
+    mach_timebase_info(&result);
+    return result;
+  }();
+  struct FrameQueue
+  {
+    int descriptor = kqueue();
+    ~FrameQueue()
+    {
+      if (descriptor >= 0)
+        close(descriptor);
+    }
+  };
+  static thread_local FrameQueue queue;
+
+  while (true)
+  {
+    const auto mach_now = mach_absolute_time();
+    const auto wait = target - Clock::now() - spin_time;
+    if (wait <= Clock::duration::zero())
+      break;
+
+    const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(wait).count();
+    const auto ticks = static_cast<std::uint64_t>(static_cast<unsigned __int128>(ns) *
+                                                  timebase.denom / timebase.numer);
+    if (queue.descriptor >= 0)
+    {
+      kevent64_s event{};
+      event.ident = 1;
+      event.filter = EVFILT_TIMER;
+      event.flags = EV_ADD | EV_ONESHOT;
+      event.fflags = NOTE_ABSOLUTE | NOTE_MACHTIME | NOTE_CRITICAL;
+      event.data = mach_now + ticks;
+      kevent64_s result{};
+      const int events = kevent64(queue.descriptor, &event, 1, &result, 1, 0, nullptr);
+      if ((events == 1 && (result.flags & EV_ERROR) == 0) || (events < 0 && errno == EINTR))
+        continue;
+    }
+    const auto result = mach_wait_until(mach_now + ticks);
+    if (result != KERN_SUCCESS && result != KERN_ABORTED)
+    {
+      std::this_thread::sleep_until(target - spin_time);
+      break;
+    }
+  }
+
+  while (Clock::now() < target)
+  {
+#if defined(__aarch64__)
+    __asm__ __volatile__("yield");
+#elif defined(__x86_64__)
+    __asm__ __volatile__("pause");
+#endif
+  }
+}
+} // namespace Common
