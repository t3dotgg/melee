+// Local Melee reads retain asynchronous completion and command latency.
+// The override supports repeatable comparisons with the original 32 MiB/s cap.
+static u64 MeleeTransferRate()
+{
+  static const u64 rate = []() -> u64 {
+    constexpr u64 default_rate = 256 * 1024 * 1024;
+    const char* text = std::getenv("MELEE_DISC_MIB_PER_SECOND");
+    if (!text)
+      return default_rate;
+    const std::string_view input(text);
+    unsigned value = 0;
+    const auto parsed = std::from_chars(input.data(), input.data() + input.size(), value);
+    if (parsed.ec != std::errc{} || parsed.ptr != input.data() + input.size() ||
+        value < 32 || value > 1024)
+      return default_rate;
+    return u64(value) * 1024 * 1024;
+  }();
+  return rate;
+}
