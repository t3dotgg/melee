+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace Melee
+{
+// Verified US v1.02 DOL, SHA-1 08e0bf20134dfcb260699671004527b2d6bb1a45:
+// 801A4DA8 bl lb_800195D0; 801A4DAC bl lb_80019894;
+// 801A4DB0 rlwinm. r27,r3,0,24,31; 801A4DB4 beq 801A4DA8.
+constexpr bool IsPadWaitLoop(const std::array<std::uint32_t, 4>& words)
+{
+  return words == std::array<std::uint32_t, 4>{0x4be74829u, 0x4be74ae9u, 0x547b063fu, 0x4182fff4u};
+}
+
+// Called only after dispatch at 801A4DB0 in strict GALE01 revision 2 local play.
+// The empty branch leaves r27=0 and enters the reset/DVD poll with LR=801A4DAC.
+// HSD_PadLibData (804C1F78) has its u8 qcount at +3; an alarm can update it
+// between the original count read and this branch, so recheck the live count.
+constexpr bool CanIdleForPadWait(std::uint32_t next_pc, std::uint32_t link_register,
+                                 std::uint32_t queue_result, std::uint8_t live_queue_count,
+                                 std::uint32_t msr, std::uint32_t pending_exceptions,
+                                 bool guest_exception, std::int64_t downcount)
+{
+  return next_pc == 0x800195D0u && link_register == 0x801A4DACu && queue_result == 0 &&
+         live_queue_count == 0 && (msr & 0x8000u) != 0 && pending_exceptions == 0 &&
+         !guest_exception && downcount > 0;
+}
+}  // namespace Melee
